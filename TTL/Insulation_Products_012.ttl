mctl:M01_T020 a bpo:Product ;
    rdfs:label "webertherm PF022 20 mm"@it ;
    schema:model mctl:M01 ;
    rdfs:comment "Pannello isolante da 20 mm. La resistenza termica e calcolata come d/lambda."@it ;
