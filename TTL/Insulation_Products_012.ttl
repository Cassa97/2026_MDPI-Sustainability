mctl:hasCostItem a owl:ObjectProperty ;
    rdfs:domain bpo:Product ;
    rdfs:range ci:CostItem .

mctl:Attr_M01_T020_density a bpo:Attribute,
        dicm:MassDensity ;
    rdfs:label "Densita della variante (kg/m3)"@it ;
    rdf:value mctl:Value_M01_T020_density .

mctl:Attr_M01_T020_gwp a bpo:Attribute,
        dice:GlobalWarmingPotential ;
    rdfs:label "GWP-total A1-A3 della variante (kg CO2e/m2)"@it ;
    rdf:value mctl:Value_M01_T020_gwp .

mctl:Attr_M01_T020_lambda a bpo:Attribute,
        dicm:ThermalConductivity ;
    rdfs:label "Conducibilita termica dichiarata lambda_D (W/(m K))"@it ;
    rdf:value mctl:Value_M01_T020_lambda .

mctl:Attr_M01_T020_r_calculated a bpo:Attribute ;
    rdfs:label "Resistenza termica calcolata d/lambda (m2 K/W)"@it ;
    rdf:value mctl:Value_M01_T020_r_calculated .

