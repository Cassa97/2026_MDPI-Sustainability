#Cross-model BIM information retrieval using SPARQL.
PREFIX bot: <https://w3id.org/bot#>
PREFIX beo: <https://pi.pauwel.be/voc/buildingelement#>
PREFIX metric: <http://example.org/metrics#>
SELECT ?interface ?wall ?covering ?overlapArea ?coverageAsIs ?coverageToBe
WHERE {
    ?interface
        a bot:Interface ;
        bot:interfaceOf ?wall, ?covering ;
        metric:overlapArea ?overlapArea ;
        metric:coverageOnAsIs ?coverageAsIs ;
        metric:coverageOnToBe ?coverageToBe .
    ?wall a beo:Wall .
    ?covering a beo:Covering .
}
ORDER BY ?wall ?covering
